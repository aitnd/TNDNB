{
    "name": "3.Content Manager",
    "nodes": [
        {
            "parameters": {
                "updates": {
                    "allowUpdates": true
                }
            },
            "id": "tg-trigger",
            "name": "Telegram Trigger",
            "type": "n8n-nodes-base.telegramTrigger",
            "typeVersion": 1.1,
            "position": [
                0,
                300
            ],
            "webhookId": "content-manager-webhook",
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TG_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "cfg-1",
                            "name": "SHEETS_ID",
                            "value": "1yXFEpFX3gTIVeEoBkziUpIOD9hYskH9yNvgzuDBAY6o",
                            "type": "string"
                        },
                        {
                            "id": "cfg-2",
                            "name": "ADMIN_CHAT_ID",
                            "value": "7455388349",
                            "type": "string"
                        },
                        {
                            "id": "cfg-3",
                            "name": "TELEGRAM_BOT_TOKEN",
                            "value": "8232622884:AAGo1yIk7TBjxMptYyrKGChIPZmJxoTyWAo",
                            "type": "string"
                        }
                    ]
                }
            },
            "id": "config",
            "name": "Config",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                220,
                300
            ]
        },
        {
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/help",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "help"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/groups",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "groups"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/status",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "status"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/accounts",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "accounts"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/new ",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "new"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/approve ",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "approve"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.message.text }}",
                                        "rightValue": "/reject ",
                                        "operator": {
                                            "type": "string",
                                            "operation": "startsWith"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "reject"
                        }
                    ]
                },
                "fallbackOutput": "extra"
            },
            "id": "switch-input",
            "name": "Phân loại Input",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3.2,
            "position": [
                440,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"🤖 <b>Content Manager Bot</b>\\n\\n📋 <b>Commands:</b>\\n/help - Xem danh sách lệnh\\n/groups - Xem nhóm kênh\\n/accounts - Xem tài khoản social\\n/status - Xem trạng thái Content Queue\\n/new [nội dung] - Tạo bài mới với AI\\n/approve [ID] - Duyệt bài (ready)\\n/reject [ID] - Từ chối bài\\n\\n💡 Gửi ảnh/video để tạo bài với media\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-help",
            "name": "Trả lời /help",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                660,
                0
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Channel Config",
                    "mode": "name"
                }
            },
            "id": "read-groups",
            "name": "Đọc Channel Config",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                660,
                100
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"📋 <b>Nhóm kênh:</b>\\n\\n{{ $json.map((g, i) => (i+1) + '. ' + (g.group_name || g.niche) + ' (' + g.status + ')').join('\\n') }}\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-groups",
            "name": "Trả lời /groups",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                880,
                100
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Content Queue",
                    "mode": "name"
                }
            },
            "id": "read-status",
            "name": "Đọc Queue Status",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                660,
                200
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"📊 <b>Content Queue Status:</b>\\n\\n✅ Published: {{ $json.filter(r => r.Status === 'published').length }}\\n⏳ Ready: {{ $json.filter(r => r.Status === 'ready').length }}\\n📝 Pending: {{ $json.filter(r => r.Status === 'pending').length }}\\n❌ Rejected: {{ $json.filter(r => r.Status === 'rejected').length }}\\n\\n📄 Tổng: {{ $json.length }} bài\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-status",
            "name": "Trả lời /status",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                880,
                200
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Account Manager",
                    "mode": "name"
                },
                "filtersUI": {
                    "values": [
                        {
                            "lookupColumn": "status",
                            "lookupValue": "active"
                        }
                    ]
                }
            },
            "id": "read-accounts",
            "name": "Đọc Account Manager",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                660,
                300
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"👤 <b>Tài khoản Active:</b>\\n\\n{{ $json.map((a, i) => (i+1) + '. ' + a.account_name + ' (' + a.platform + ')').join('\\n') }}\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-accounts",
            "name": "Trả lời /accounts",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                880,
                300
            ]
        },
        {
            "parameters": {
                "modelId": {
                    "__rl": true,
                    "value": "models/gemini-2.0-flash",
                    "mode": "list"
                },
                "promptType": "define",
                "text": "=Người dùng yêu cầu: {{ $('Telegram Trigger').item.json.message.text.replace('/new ', '') }}\n\nHãy viết một bài đăng Facebook hấp dẫn bằng tiếng Việt (200-300 từ):\n- Mở đầu thu hút, gây tò mò\n- Nội dung có giá trị\n- Kết thúc với CTA\n- Thêm 5-7 hashtag phù hợp cuối bài"
            },
            "id": "ai-create",
            "name": "AI tạo content",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                660,
                400
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini"
                }
            }
        },
        {
            "parameters": {
                "operation": "append",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Content Queue",
                    "mode": "name"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "ID": "=POST_{{ $now.format('yyyyMMdd_HHmmss') }}",
                        "Timestamp": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
                        "Source": "Manual_Telegram",
                        "Text_Content": "={{ $json.text }}",
                        "Platform": "Facebook",
                        "Status": "pending"
                    }
                }
            },
            "id": "save-content",
            "name": "Lưu Content Queue",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                880,
                400
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"✅ <b>Đã tạo bài mới!</b>\\n\\n📝 Preview:\\n{{ $('AI tạo content').item.json.text.substring(0, 200) }}...\\n\\n⏳ Status: pending\\n\\n👉 Dùng /approve [ID] để duyệt\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-preview",
            "name": "Preview",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1100,
                400
            ]
        },
        {
            "parameters": {
                "jsCode": "const text = $('Telegram Trigger').item.json.message.text;\nconst postId = text.replace('/approve ', '').trim();\nreturn { post_id: postId };"
            },
            "id": "parse-approve",
            "name": "Parse Approve ID",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                660,
                500
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Content Queue",
                    "mode": "name"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "Status": "ready"
                    },
                    "matchingColumns": [
                        "ID"
                    ]
                },
                "options": {
                    "dataLocationOnSheet": {
                        "values": {
                            "lookupColumn": "ID",
                            "lookupValue": "={{ $json.post_id }}"
                        }
                    }
                }
            },
            "id": "approve-post",
            "name": "Approve Post",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                880,
                500
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
