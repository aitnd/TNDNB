        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"❌ Đã từ chối bài {{ $('Parse Reject ID').item.json.post_id }}\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-rejected",
