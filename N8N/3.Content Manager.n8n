                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"💬 Không hiểu lệnh. Gõ /help để xem danh sách lệnh.\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "fallback",
            "name": "Fallback Reply",
            "type": "n8n-nodes-base.httpRequest",
