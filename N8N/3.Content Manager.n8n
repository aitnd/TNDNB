        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.ADMIN_CHAT_ID }}\", \"text\": \"✅ Đã duyệt bài {{ $('Parse Approve ID').item.json.post_id }}\\n\\nStatus: ready - sẵn sàng đăng\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "reply-approved",
            "name": "Reply Approved",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1100,
                500
            ]
        },
        {
            "parameters": {
                "jsCode": "const text = $('Telegram Trigger').item.json.message.text;\nconst postId = text.replace('/reject ', '').trim();\nreturn { post_id: postId };"
            },
            "id": "parse-reject",
            "name": "Parse Reject ID",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                660,
                600
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Content Queue",
                    "mode": "name"
                },
                "columns": {
