{
    "name": "5.Affiliate Bot",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 9
                        }
                    ]
                }
            },
            "id": "schedule-daily",
            "name": "Schedule Hàng Ngày",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                0,
                100
            ]
        },
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "affiliate-get-link",
                "options": {}
            },
            "id": "webhook-get",
            "name": "API Get Link",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                0,
                400
            ],
            "webhookId": "affiliate-get-link"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "cfg-1",
                            "name": "SHEETS_ID",
                            "value": "1yXFEpFX3gTIVeEoBkziUpIOD9hYskH9yNvgzuDBAY6o",
                            "type": "string"
                        },
                        {
                            "id": "cfg-2",
                            "name": "SHOPEE_AFFILIATE_ID",
                            "value": "YOUR_SHOPEE_ID",
                            "type": "string"
                        },
                        {
                            "id": "cfg-3",
                            "name": "TELEGRAM_CHAT_ID",
                            "value": "7455388349",
                            "type": "string"
                        }
                    ]
                }
            },
            "id": "config",
            "name": "Config",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                220,
                100
            ]
        },
        {
            "parameters": {
                "url": "https://affiliate.shopee.vn/api/v1/product/list",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "sort",
                            "value": "sales"
                        },
                        {
                            "name": "limit",
                            "value": "20"
                        }
                    ]
                }
            },
            "id": "crawl-shopee",
            "name": "Crawl Shopee Hot",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                440,
                100
            ]
        },
        {
            "parameters": {
                "operation": "appendOrUpdate",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Affiliate Database",
                    "mode": "name"
                },
                "columns": {
                    "mappingMode": "autoMapInputData",
                    "matchingColumns": [
                        "product_id"
                    ]
                }
            },
            "id": "save-products",
            "name": "Lưu Affiliate DB",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                660,
                100
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "chatId": "={{ $('Config').item.json.TELEGRAM_CHAT_ID }}",
                "text": "=🛒 Đã cập nhật {{ $json.length }} sản phẩm hot từ Shopee!"
            },
            "id": "notify-crawl",
            "name": "Notify Crawl Done",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.2,
            "position": [
                880,
                100
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TG_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "1yXFEpFX3gTIVeEoBkziUpIOD9hYskH9yNvgzuDBAY6o",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Affiliate Database",
                    "mode": "name"
                },
                "filtersUI": {
                    "values": [
                        {
                            "lookupColumn": "category",
                            "lookupValue": "={{ $json.body.category }}"
                        }
                    ]
                }
            },
            "id": "search-product",
            "name": "Tìm sản phẩm",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                220,
                400
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const products = $input.all();\nif (products.length === 0) {\n  return { affiliate_link: null, message: 'Không tìm thấy sản phẩm phù hợp' };\n}\nconst best = products[0].json;\nreturn {\n  product_name: best.product_name,\n  affiliate_link: best.affiliate_link,\n  price: best.price,\n  commission: best.commission\n};"
            },
            "id": "pick-best",
            "name": "Chọn sản phẩm tốt nhất",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                400
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify($json) }}"
            },
            "id": "respond-link",
            "name": "Trả về Link",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                660,
                400
            ]
        }
    ],
    "connections": {
        "Schedule Hàng Ngày": {
            "main": [
                [
                    {
                        "node": "Config",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Config": {
            "main": [
                [
                    {
                        "node": "Crawl Shopee Hot",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Crawl Shopee Hot": {
            "main": [
                [
                    {
                        "node": "Lưu Affiliate DB",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Lưu Affiliate DB": {
            "main": [
                [
                    {
                        "node": "Notify Crawl Done",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "API Get Link": {
            "main": [
                [
                    {
                        "node": "Tìm sản phẩm",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Tìm sản phẩm": {
            "main": [
                [
                    {
                        "node": "Chọn sản phẩm tốt nhất",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Chọn sản phẩm tốt nhất": {
            "main": [
                [
                    {
                        "node": "Trả về Link",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "active": false,
    "tags": []
}