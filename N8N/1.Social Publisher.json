            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://api.telegram.org/bot{{ $('Config').item.json.TELEGRAM_BOT_TOKEN }}/sendMessage",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"chat_id\": \"{{ $('Config').item.json.TELEGRAM_CHAT_ID }}\", \"text\": \"✅ Đã đăng bài lên {{ $('Gộp Data').item.json.platform }}!\\n\\n📝 {{ $('Gộp Data').item.json.account_name }}\\n🔗 Post ID: {{ $json.id || $json.post_id || 'N/A' }}\", \"parse_mode\": \"HTML\" }",
                "options": {}
            },
            "id": "notify-tg",
            "name": "Thông báo Telegram",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1760,
                300
            ]
        },
        {
            "parameters": {},
            "id": "skip",
            "name": "Skip (Unknown Platform)",
            "type": "n8n-nodes-base.noOp",
            "typeVersion": 1,
            "position": [
                1320,
                700
            ]
        }
    ],
