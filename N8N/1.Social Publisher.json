                    "values": [
                        {
                            "lookupColumn": "Status",
                            "lookupValue": "ready"
                        }
                    ]
                },
                "options": {
                    "returnFirstMatch": true
                }
            },
            "id": "read-queue",
            "name": "Đọc Content Queue",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                440,
                300
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Account Manager",
                    "mode": "name"
                },
                "filtersUI": {
                    "values": [
                        {
                            "lookupColumn": "platform",
                            "lookupValue": "={{ $json.Platform }}"
                        },
                        {
                            "lookupColumn": "status",
                            "lookupValue": "active"
                        }
                    ]
                },
                "options": {
                    "returnFirstMatch": true
                }
            },
            "id": "read-accounts",
            "name": "Đọc Account Manager",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                660,
                300
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Lấy content từ queue và account info\nconst content = $('Đọc Content Queue').first().json;\nconst account = $('Đọc Account Manager').first().json;\n\nreturn {\n  content_id: content.ID,\n  text: content.Text_Content,\n  hashtags: content.Hashtags || '',\n  media_url: content.Media_URL || '',\n  platform: content.Platform,\n  page_id: account.page_id,\n  access_token: account.access_token,\n  account_name: account.account_name\n};"
            },
            "id": "merge-data",
            "name": "Gộp Data",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                880,
                300
            ]
        },
        {
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.platform }}",
                                        "rightValue": "Facebook",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "Facebook"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.platform }}",
                                        "rightValue": "YouTube",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "YouTube"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.platform }}",
                                        "rightValue": "TikTok",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "TikTok"
                        },
                        {
                            "conditions": {
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.platform }}",
                                        "rightValue": "Instagram",
                                        "operator": {
                                            "type": "string",
                                            "operation": "equals"
                                        }
                                    }
                                ]
                            },
                            "renameOutput": true,
                            "outputKey": "Instagram"
                        }
                    ]
                },
                "fallbackOutput": "extra"
            },
            "id": "switch-platform",
            "name": "Switch Platform",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3.2,
            "position": [
                1100,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://graph.facebook.com/v21.0/{{ $json.page_id }}/feed",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "access_token",
                            "value": "={{ $json.access_token }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"message\": \"{{ $json.text }}\\n\\n{{ $json.hashtags }}\" }",
                "options": {}
            },
            "id": "post-fb",
            "name": "Đăng Facebook",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1320,
                100
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://www.googleapis.com/upload/youtube/v3/videos?part=snippet,status",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $json.access_token }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"snippet\": { \"title\": \"{{ $json.text.substring(0, 100) }}\", \"description\": \"{{ $json.text }}\\n\\n{{ $json.hashtags }}\" }, \"status\": { \"privacyStatus\": \"public\" } }",
                "options": {}
            },
            "id": "post-yt",
            "name": "Đăng YouTube",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1320,
                250
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://open.tiktokapis.com/v2/post/publish/video/init/",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "=Bearer {{ $json.access_token }}"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"post_info\": { \"title\": \"{{ $json.text.substring(0, 150) }}\", \"privacy_level\": \"PUBLIC_TO_EVERYONE\" }, \"source_info\": { \"source\": \"PULL_FROM_URL\", \"video_url\": \"{{ $json.media_url }}\" } }",
                "options": {}
            },
            "id": "post-tiktok",
            "name": "Đăng TikTok",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1320,
                400
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "=https://graph.facebook.com/v21.0/{{ $json.page_id }}/media",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "access_token",
                            "value": "={{ $json.access_token }}"
                        },
                        {
                            "name": "caption",
                            "value": "={{ $json.text }}\\n\\n{{ $json.hashtags }}"
                        },
                        {
                            "name": "image_url",
                            "value": "={{ $json.media_url }}"
                        }
                    ]
                },
                "options": {}
            },
            "id": "post-ig",
            "name": "Đăng Instagram",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1320,
                550
            ]
        },
        {
            "parameters": {
                "operation": "update",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Content Queue",
                    "mode": "name"
                },
                "columns": {
                    "mappingMode": "defineBelow",
                    "value": {
                        "Status": "published",
                        "Published_At": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
                        "Post_ID": "={{ $json.id || $json.post_id || 'N/A' }}"
                    },
                    "matchingColumns": [
                        "ID"
                    ]
                }
            },
            "id": "update-status",
            "name": "Cập nhật Status",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                1540,
