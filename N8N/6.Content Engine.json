            "id": "translate",
            "name": "Gemini Dịch",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                1100,
                450
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "// Tạo file SRT từ transcript đã dịch\nconst text = $input.item.json.text;\nconst lines = text.split('\\n');\nlet srt = '';\nlet counter = 1;\n\n// Tạo SRT đơn giản (mỗi 5 giây 1 dòng)\nconst words = text.split(' ');\nconst wordsPerLine = 10;\nfor (let i = 0; i < words.length; i += wordsPerLine) {\n  const startSec = Math.floor(i / wordsPerLine) * 5;\n  const endSec = startSec + 5;\n  const startTime = `00:${String(Math.floor(startSec/60)).padStart(2,'0')}:${String(startSec%60).padStart(2,'0')},000`;\n  const endTime = `00:${String(Math.floor(endSec/60)).padStart(2,'0')}:${String(endSec%60).padStart(2,'0')},000`;\n  srt += `${counter}\\n${startTime} --> ${endTime}\\n${words.slice(i, i+wordsPerLine).join(' ')}\\n\\n`;\n  counter++;\n}\n\nreturn { srt_content: srt, srt_path: `/tmp/subtitle_${Date.now()}.srt` };"
            },
            "id": "generate-srt",
            "name": "Generate SRT",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1320,
                450
            ]
        },
        {
            "parameters": {
                "command": "=echo '{{ $json.srt_content }}' > {{ $json.srt_path }} && ffmpeg -i /tmp/subtitle_*.mp4 -vf subtitles={{ $json.srt_path }} /tmp/subtitled_{{ Date.now() }}.mp4 && echo '{\"output_url\": \"/tmp/subtitled_{{ Date.now() }}.mp4\"}'"
            },
