{
  "name": "Youtube Search Workflow",
  "nodes": [
    {
      "parameters": {
        "events": "worklfow_call",
        "inputSource": "workflowInputs",
        "workflowInputs": {}
      },
      "id": "trigger-001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        112,
        304
      ],
      "issues": {
        "parameters": {
          "workflowInputs": [
            "At least 1 field is required."
          ]
        }
      }
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "getAll",
        "returnAll": false,
        "limit": 5,
        "filters": {
          "publishedAfter": "={{ new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).toISOString() }}",
          "q": "={{ $json.query?.search_term || $json.search_term }}",
          "regionCode": "US"
        },
        "options": {
          "order": "relevance",
          "safeSearch": "moderate"
        }
      },
      "id": "youtube-001",
      "name": "YouTube Search",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        320,
        304
      ],
      "issues": {},
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "A3Z1NxotiDAzICLi",
          "name": "YouTube account"
        }
      }
    },
    {
      "parameters": {
        "splitInBatchesNotice": "",
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-001",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        544,
        304
      ]
    },
    {
      "parameters": {
        "preBuiltAgentsCalloutHttpRequest": "",
        "curlImport": "",
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/videos",
        "authentication": "none",
        "provideSslCertificates": false,
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env[\"GOOGLE_API_KEY\"] }}"
            },
            {
              "name": "id",
              "value": "={{ $json.id?.videoId || $json.id }}"
            },
            {
              "name": "part",
              "value": "contentDetails,snippet,statistics"
            }
          ]
        },
        "sendHeaders": false,
        "sendBody": false,
        "options": {},
        "infoMessage": ""
      },
      "id": "http-001",
      "name": "Get Video Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        768,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "filter-001",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.items && $json.items.length > 0 }}",
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": false,
        "options": {}
      },
      "id": "if-001",
      "name": "Has Video Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        992,
        400
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-001",
              "name": "id",
              "type": "string",
              "value": "={{ $json.items[0].id }}"
            },
            {
              "id": "assign-002",
              "name": "title",
              "type": "string",
              "value": "={{ $json.items[0].snippet.title }}"
            },
            {
              "id": "assign-003",
              "name": "description",
              "type": "string",
              "value": "={{ $json.items[0].snippet.description?.substring(0, 500) }}"
            },
            {
              "id": "assign-004",
              "name": "channelTitle",
              "type": "string",
              "value": "={{ $json.items[0].snippet.channelTitle }}"
            },
            {
              "id": "assign-005",
              "name": "channelId",
              "type": "string",
              "value": "={{ $json.items[0].snippet.channelId }}"
            },
            {
              "id": "assign-006",
              "name": "viewCount",
              "type": "number",
              "value": "={{ parseInt($json.items[0].statistics.viewCount) || 0 }}"
            },
            {
              "id": "assign-007",
              "name": "likeCount",
              "type": "number",
              "value": "={{ parseInt($json.items[0].statistics.likeCount) || 0 }}"
            },
            {
              "id": "assign-008",
              "name": "commentCount",
              "type": "number",
              "value": "={{ parseInt($json.items[0].statistics.commentCount) || 0 }}"
            },
            {
              "id": "assign-009",
              "name": "tags",
              "type": "string",
              "value": "={{ ($json.items[0].snippet.tags || []).join(', ') }}"
            },
            {
              "id": "assign-010",
              "name": "duration",
              "type": "string",
              "value": "={{ $json.items[0].contentDetails.duration }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "set-001",
      "name": "Format Video Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Lưu dữ liệu video vào memory\nconst workflowStaticData = $getWorkflowStaticData('global');\n\nif (!workflowStaticData.videos) {\n  workflowStaticData.videos = [];\n}\n\n// Thêm video hiện tại\nworkflowStaticData.videos.push($input.item.json);\n\nreturn { collected: workflowStaticData.videos.length };",
        "notice": ""
      },
      "id": "code-001",
      "name": "Save to Memory",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1424,
        304
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Lấy tất cả videos đã thu thập\nconst workflowStaticData = $getWorkflowStaticData('global');\nconst videos = workflowStaticData.videos || [];\n\n// Xóa cache để lần chạy sau không bị trùng\nworkflowStaticData.videos = [];\n\n// Format kết quả\nlet result = '';\nvideos.forEach((video, index) => {\n  if (index > 0) result += '\\n\\n### NEXT VIDEO FOUND: ###\\n\\n';\n  result += `Title: ${video.title}\\n`;\n  result += `Channel: ${video.channelTitle}\\n`;\n  result += `Views: ${video.viewCount?.toLocaleString() || 'N/A'}\\n`;\n  result += `Likes: ${video.likeCount?.toLocaleString() || 'N/A'}\\n`;\n  result += `Comments: ${video.commentCount?.toLocaleString() || 'N/A'}\\n`;\n  result += `Tags: ${video.tags || 'None'}\\n`;\n  result += `Video ID: ${video.id}\\n`;\n  result += `Channel ID: ${video.channelId}`;\n});\n\nreturn { response: result || 'No videos found for this search term.' };",
        "notice": ""
      },
      "id": "code-002",
      "name": "Compile Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        208
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "YouTube Search",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "YouTube Search": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [
          {
            "node": "Compile Results",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get Video Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Video Details": {
      "main": [
        [
          {
            "node": "Has Video Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Video Data": {
      "main": [
        [
          {
            "node": "Format Video Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Video Data": {
      "main": [
        [
          {
            "node": "Save to Memory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Memory": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": false
  },
  "pinData": {}
}