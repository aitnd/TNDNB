{
    "name": "4.Auto Responder",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "facebook-webhook",
                "options": {}
            },
            "id": "webhook",
            "name": "Facebook Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                0,
                300
            ],
            "webhookId": "fb-auto-responder"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "cfg-1",
                            "name": "SHEETS_ID",
                            "value": "1yXFEpFX3gTIVeEoBkziUpIOD9hYskH9yNvgzuDBAY6o",
                            "type": "string"
                        },
                        {
                            "id": "cfg-2",
                            "name": "TELEGRAM_CHAT_ID",
                            "value": "7455388349",
                            "type": "string"
                        }
                    ]
                }
            },
            "id": "config",
            "name": "Config",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                220,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "conditions": [
                        {
                            "leftValue": "={{ $json.body.entry[0].messaging }}",
                            "rightValue": "",
                            "operator": {
                                "type": "string",
                                "operation": "exists"
                            }
                        }
                    ]
                }
            },
            "id": "check-msg",
            "name": "Có message?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                440,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const entry = $input.item.json.body.entry[0];\nconst messaging = entry.messaging[0];\nconst page_id = entry.id;\nreturn {\n  sender_id: messaging.sender.id,\n  message_text: messaging.message?.text || '',\n  is_echo: messaging.message?.is_echo || false,\n  page_id: page_id\n};"
            },
            "id": "parse-msg",
            "name": "Parse Message",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                660,
                200
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "conditions": [
                        {
                            "leftValue": "={{ $json.is_echo }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "notEquals"
                            }
                        }
                    ]
                }
            },
            "id": "not-echo",
            "name": "Không phải echo?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                880,
                200
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "documentId": {
                    "__rl": true,
                    "value": "={{ $('Config').item.json.SHEETS_ID }}",
                    "mode": "id"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "Account Manager",
                    "mode": "name"
                },
                "filtersUI": {
                    "values": [
                        {
                            "lookupColumn": "page_id",
                            "lookupValue": "={{ $json.page_id }}"
                        }
                    ]
                }
            },
            "id": "get-account",
            "name": "Lấy Account Info",
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "position": [
                1100,
                100
            ],
            "credentials": {
                "googleSheetsOAuth2Api": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Sheets OAuth2"
                }
            }
        },
        {
            "parameters": {
                "modelId": {
                    "__rl": true,
                    "value": "models/gemini-2.0-flash",
                    "mode": "list"
                },
                "promptType": "define",
                "text": "=Bạn là AI assistant của fanpage {{ $json[0].account_name }}. Khách hàng nhắn: \"{{ $('Parse Message').item.json.message_text }}\"\n\nHãy trả lời ngắn gọn, thân thiện bằng tiếng Việt (tối đa 100 từ)."
            },
            "id": "ai-reply",
            "name": "AI Gemini trả lời",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                1320,
                100
            ],
            "credentials": {
                "googleGeminiApi": {
                    "id": "YOUR_GEMINI_CREDENTIAL_ID",
                    "name": "Google Gemini"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://graph.facebook.com/v21.0/me/messages",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "access_token",
                            "value": "={{ $('Lấy Account Info').first().json.access_token }}"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={ \"recipient\": { \"id\": \"{{ $('Parse Message').item.json.sender_id }}\" }, \"message\": { \"text\": \"{{ $json.text }}\" } }"
            },
            "id": "send-reply",
            "name": "Gửi Reply",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1540,
                100
            ]
        },
        {
            "parameters": {
                "chatId": "={{ $('Config').item.json.TELEGRAM_CHAT_ID }}",
                "text": "=💬 Auto Reply {{ $('Lấy Account Info').first().json.account_name }}!\n\n👤 Khách: {{ $('Parse Message').item.json.message_text }}\n🤖 AI: {{ $('AI Gemini trả lời').item.json.text.substring(0, 100) }}..."
            },
            "id": "notify",
            "name": "Log Telegram",
            "type": "n8n-nodes-base.telegram",
            "typeVersion": 1.2,
            "position": [
                1760,
                100
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TG_CREDENTIAL_ID",
                    "name": "Telegram Bot"
                }
            }
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={ \"status\": \"ok\" }"
            },
            "id": "respond",
            "name": "Respond OK",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                660,
                400
            ]
        }
    ],
    "connections": {
        "Facebook Webhook": {
            "main": [
                [
                    {
                        "node": "Config",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Config": {
            "main": [
                [
                    {
                        "node": "Có message?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Có message?": {
            "main": [
                [
                    {
                        "node": "Parse Message",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Respond OK",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Parse Message": {
            "main": [
                [
                    {
                        "node": "Không phải echo?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Không phải echo?": {
            "main": [
                [
                    {
                        "node": "Lấy Account Info",
                        "type": "main",
                        "index": 0
                    }
                ],
                []
            ]
        },
        "Lấy Account Info": {
            "main": [
                [
                    {
                        "node": "AI Gemini trả lời",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "AI Gemini trả lời": {
            "main": [
                [
                    {
                        "node": "Gửi Reply",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gửi Reply": {
            "main": [
                [
                    {
                        "node": "Log Telegram",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    },
    "active": false,
    "tags": []
}